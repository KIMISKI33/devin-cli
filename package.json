{
  "name": "devin-cli",
  "version": "1.0.0",
  "description": "Autonomous AI Software Engineer CLI",
  "main": "dist/agent.js",
  "bin": {
    "devin": "./bin/devin.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "ts-node agent.ts",
    "test": "tsc && node --test dist/tests/",
    "package": "tsc && pkg . --compress Brotli --targets node18-linux-x64,node18-macos-x64,node18-win-x64 --output devin"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "autonomous"
  ],
  "author": "Devin",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "pkg": "^5.8.1",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "pkg": {
    "scripts": [
      "dist/agent.js",
      "dist/src/**/*.js"
    ]
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  }
}
