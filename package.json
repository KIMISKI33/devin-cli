{
  "name": "devin-cli",
  "version": "1.0.0",
  "description": "Autonomous AI Software Engineer CLI",
  "main": "dist/agent.js",
  "bin": {
    "devin": "./dist/agent.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "ts-node agent.ts",
    "package": "tsc && pkg . --targets node18-linux-x64,node18-macos-x64,node18-win-x64 --output devin"
  },
  "keywords": ["ai", "agent", "cli", "autonomous"],
  "author": "Devin",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.28.0",
    "@google/genai": "^2.10.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "pkg": "^5.11.5"
  },
  "pkg": {
    "scripts": ["dist/agent.js"],
    "assets": ["node_modules/@anthropic-ai/sdk/**/*", "node_modules/dotenv/**/*"]
  }
}
