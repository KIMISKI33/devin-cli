{
  "name": "devin-standalone-tcof",
  "version": "1.0.0",
  "description": "Devin autonomous agent with TCOF (Transactional Code Orchestration Framework) integration",
  "type": "module",
  "main": "devin-standalone-tcof.ts",
  "bin": {
    "devin": "devin-standalone-tcof.ts"
  },
  "scripts": {
    "build": "tsc --outDir dist --declaration",
    "type-check": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 src/**/*.test.ts",
    "dev": "node --loader ts-node/esm devin-standalone-tcof.ts",
    "start": "node devin-standalone-tcof.ts"
  },
  "keywords": [
    "ai",
    "agent",
    "automation",
    "claude",
    "orchestration",
    "transactions"
  ],
  "author": "Devin",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "commander": "^15.0.0",
    "firecrawl": "^4.30.0",
    "node-fetch": "^2.6.12",
    "openai": "^6.45.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.3.0"
  }
}
